{
  "name": "skillpacker",
  "version": "0.1.0",
  "description": "Resolve, lock, and bundle agent skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willtsai/skillpacker.git"
  },
  "homepage": "https://github.com/willtsai/skillpacker#readme",
  "bugs": { "url": "https://github.com/willtsai/skillpacker/issues" },
  "type": "module",
  "bin": { "skillpacker": "./dist/src/cli.js" },
  "exports": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": ["dist/src", "README.md"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/integration.test.js dist/test/resolver.test.js",
    "test:package": "node --test scripts/package.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "zod": "^4.6.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
